# Copy to .env. Existing shell variables take precedence.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-replace-this-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Dhaka
# Relative to the project root, or an absolute path.
SQLITE_PATH=db.sqlite3
# Future local LLM service configuration; currently unused.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
