# Copy to .env. Existing shell variables take precedence.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-replace-this-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Dhaka
# Relative to the project root, or an absolute path.
SQLITE_PATH=db.sqlite3
# Local Ollama service configuration. Diagnostics do not generate text.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Audio uploads: default 100 MB; FFmpeg must provide ffprobe on PATH.
MAX_AUDIO_UPLOAD_BYTES=104857600
FFPROBE_BINARY=ffprobe

# Local preprocessing binaries and time limits.
FFMPEG_BINARY=ffmpeg
AUDIO_PROCESS_TIMEOUT_SECONDS=600
AUDIO_PROBE_TIMEOUT_SECONDS=20

# Local Silero VAD: threshold (0, 1), nonnegative durations in milliseconds.
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=500
VAD_SPEECH_PAD_MS=30

# Local faster-whisper. CPU defaults; CUDA requires compatible local GPU libraries.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=models/whisper

OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_HEALTH_TIMEOUT_SECONDS=3

# Notes: Unicode character budgets (not token counts), and local model context.
NOTES_CHUNK_SIZE=4000
NOTES_MAX_OUTPUT_CHARS=3000
OLLAMA_CONTEXT_SIZE=16384

# Local Ask AI retrieval; run download_embedding_model explicitly.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_PATH=models/embeddings/multilingual-e5-small
EMBEDDING_REVISION=main
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
RAG_CHUNK_CHARS=800
RAG_CHUNK_TOKENS=256
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.72
RAG_CONTEXT_CHARS=5000

# Local quiz/flashcard generation defaults; UI also accepts 1–20 of each.
QUIZ_QUESTION_COUNT=10
FLASHCARD_COUNT=10
STUDY_GENERATION_BATCH_SIZE=2
STUDY_SOURCE_CHARS=4000
STUDY_MAX_RESPONSE_CHARS=12000

# Optional compatible Unicode font, e.g. an installed OFL Noto Sans Bengali TTF.
# PDF_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSansBengali-Regular.ttf
PDF_FONT_PATH=

# Local Redis broker and optional task results (never hosted inference).
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Hybrid importance detection; confidence is model-reported, not calibrated.
IMPORTANCE_MIN_CONFIDENCE=0.75
IMPORTANCE_BATCH_SIZE=4
